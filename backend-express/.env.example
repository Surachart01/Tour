# PostgreSQL connection used only by the backend.
# On Railway, set DATABASE_URL as a service variable and reference the new
# PostgreSQL service (for example: ${{Postgres.DATABASE_URL}}).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

PORT=8081
NODE_ENV=development
JWT_SECRET="replace-with-a-long-random-secret"
BANK_ENCRYPTION_KEY="replace-with-a-32-byte-secret"

# Outgoing email (optional for local development).
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""
RESERVATION_EMAIL="reservation@verathailandia.com"
